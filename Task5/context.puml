@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Контекст системы - подача заявки на кредит онлайн

Person(client, "Клиент", "существующий клиент банка, подаёт заявку на кредит в интернет-банке")
Person(new_client, "Новый клиент", "подаёт заявку на кредит через сайт")
Person(branch_manager, "Менеджер отделения", "продолжает работу с заявкой клиента в АБС")
Person(credit_manager, "Менеджер кредитного отдела", "обрабатывает заявки в кредитном конвейере")

System(internet_bank, "Интернет-банк", "клиент видит предодобренные предложения и подаёт заявку на кредит")
System(site, "Сайт банка", "новый клиент оставляет заявку, получает предварительное решение")
System(abs, "АБС", "хранит заявки, передаёт их в кредитный конвейер раз в сутки")
System(credit_conveyor, "Кредитный конвейер", "менеджеры обрабатывают заявки на кредит")
System(scoring, "Система скоринга", "рассчитывает кредитный рейтинг клиента")

System_Ext(bki, "Бюро кредитных историй", "внешний REST API, данные о кредитной истории")
System_Ext(sms, "СМС-шлюз", "отправляет смс клиенту при изменении статуса заявки")

Rel(client, internet_bank, "подаёт заявку на кредит", "HTTPS")
Rel(new_client, site, "оставляет заявку, получает решение", "HTTPS")
Rel(branch_manager, abs, "продолжает работу с заявкой клиента")
Rel(credit_manager, credit_conveyor, "обрабатывает заявки")
Rel(internet_bank, abs, "передаёт заявку")
Rel(site, scoring, "запрашивает скоринг для нового клиента", "API")
Rel(abs, credit_conveyor, "передаёт заявки раз в сутки", "интеграция через БД")
Rel(credit_conveyor, scoring, "запрашивает скоринг", "API")
Rel(scoring, bki, "запрашивает кредитную историю", "REST API")
Rel(abs, sms, "отправляет уведомления об изменении статуса", "HTTP")

@enduml